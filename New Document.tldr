						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The main problem is that your canvas doesn't have explicit width and height attributes in the HTML, so it's not using the CSS dimensions for drawing. This causes a mismatch between where you click and where the drawing appears."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "so we add --> canvas.width=800;"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "and canvas.height=600;"
								}
							]
						}
					]
				}
